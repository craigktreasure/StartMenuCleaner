<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <!-- Exclude generated code from code coverage results. -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <!-- Exclude source generator output, which is written under the intermediate output path. -->
        <Source>.*[/\\]obj[/\\].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
